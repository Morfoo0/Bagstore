APP_NAME=BagStore API
APP_VERSION=0.1.0
API_DESCRIPTION=API de catálogo de BagStore.
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=postgresql+psycopg://bagstore:bagstore@localhost:5432/bagstore
TEST_DATABASE_URL=postgresql+psycopg://bagstore:bagstore@localhost:5432/bagstore_test
DATABASE_ECHO=false
SESSION_TTL_MINUTES=1440
ADMIN_EMAIL=admin@bagstore.com
ADMIN_PASSWORD=cambiar-en-desarrollo
API_PREFIX=/api
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST","PUT","DELETE","OPTIONS"]
CORS_ALLOW_HEADERS=["Accept","Authorization","Content-Type"]
