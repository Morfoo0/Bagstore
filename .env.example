# Copiar a .env.local. api consulta el servidor; demo conserva el prototipo independiente.
VITE_DATA_SOURCE=api
# Vacío: mismo origen y proxy /api en Vite. En producción configurar proxy o URL raíz HTTPS.
VITE_API_BASE_URL=
VITE_API_HEALTH_PATH=/api/health
# Solo desarrollo: servidor Python, sin /api al final.
API_PROXY_TARGET=http://127.0.0.1:8001
# No incluir claves privadas, contraseñas ni credenciales en variables VITE_.

# Backend completo incluido en backend/. Usar 0 solo con el catálogo inicial del equipo.
VITE_INTEGRATED_BACKEND=1
